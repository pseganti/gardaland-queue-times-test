name: Update Gardaland Tickets Prices

# Avvio solo da cron-job.org (o a mano dal tab Actions): nessun orario automatico di GitHub
on:
  workflow_dispatch:

jobs:
  scrape-tickets:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Dependencies
        run: npm install playwright

      - name: Install Playwright Browsers
        run: npx playwright install chromium --with-deps

      - name: Run Tickets Scraper
        run: node .github/workflows/scripts/gardaland-tickets-scraper.mjs

      - name: Commit and Push changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add gardaland-tickets-export.json || true
          git commit -m "auto: update tickets prices export [skip ci]" || exit 0
          git pull --rebase origin main
          git push
